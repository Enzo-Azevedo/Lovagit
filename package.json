{
  "name": "lovagit",
  "version": "0.3.0",
  "private": true,
  "description": "Extensao de navegador: um chat de IA isolado por repositorio do GitHub",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
